// Prisma schema untuk MyRent
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PENYEWA
  PEMILIK
  ADMIN
}

/**
 * Status verifikasi KYC yang dipakai Portal Verifikasi Admin.
 *
 * - MENUNGGU          : pengajuan baru dikirim, belum ditinjau admin
 * - PERLU_PERBAIKAN  : admin meminta pengaju memperbaiki step tertentu
 * - DISETUJUI        : akun aktif, penyewa boleh masuk ke /beranda-sewa
 * - DITOLAK          : pengajuan ditolak permanen
 */
enum VerificationStatus {
  MENUNGGU
  PERLU_PERBAIKAN
  DISETUJUI
  DITOLAK
}

/**
 * Status siklus hidup alat yang disewakan.
 *
 * - TERSEDIA   : alat siap disewa dan tampil di katalog penyewa
 * - DISEWA     : sedang disewa penyewa lain (disembunyikan dari katalog)
 * - MAINTENANCE: sedang diservis / rawat (disembunyikan dari katalog)
 */
enum EquipmentStatus {
  TERSEDIA
  DISEWA
  MAINTENANCE
  INSPEKSI
  NONAKTIF
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  fullName  String
  phone     String

  // Kode pengajuan unik (mis. VR-2041) untuk tracking di portal admin.
  submissionCode String? @unique
  // Status alur verifikasi KYC yang ditangani admin.
  verificationStatus VerificationStatus @default(MENUNGGU)
  // Seluruh data form registrasi Step 1-5 (termasuk metadata file foto).
  kycData Json?
  // Array nomor step yang diminta diperbaiki admin (mis. [1, 3]).
  revisionSteps Json?
  // Catatan admin: alasan perbaikan atau penolakan.
  adminNote String? @db.Text

  // Saldo dompet digital / escrow payout
  walletBalance Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipments Equipment[]
  orders     Order[]
  reviews    Review[]

  renterConversations Conversation[] @relation("RenterConversations")
  ownerConversations  Conversation[] @relation("OwnerConversations")
  sentMessages        Message[]      @relation("SentMessages")

  withdrawalAccounts  WithdrawalAccount[]
  walletTransactions  WalletTransaction[]
}

model Equipment {
  id          String   @id @default(uuid())
  ownerId     String
  name        String
  category    String
  description String   @db.Text
  pricePerDay Int
  deposit     Int
  powerWatt   Int
  weightKg    Float    @default(10)
  dimensions  String   @default("40 × 30 × 30 cm")
  // Durasi minimal hari penyewaan
  minRentDays Int      @default(1)
  // Jeda rawat yang harus disisihkan setelah alat kembali dari penyewa.
  maintenanceBufferDays Int    @default(1)
  location    String   @default("Jakarta Selatan")
  // Jarak (km) dari titik acuan penyewa — sementara dipakai untuk badge "Terdekat".
  distance    Float    @default(2.5)
  status      EquipmentStatus @default(TERSEDIA)
  // Array URL foto alat (JSON array of string).
  images      Json?
  // Daftar kelengkapan / aksesoris (JSON array of string, mis. ["Kabel", "Nozzle"])
  accessories Json?
  // Metode pengiriman yang didukung (JSON array of string, mis. ["PICKUP", "COURIER"])
  deliveryMethods Json?
  // Kondisi alat (mis. "Prima", "Terawat", "Sangat Baik")
  condition   String   @default("Prima")
  stock       Int      @default(1)
  // Soft delete flag untuk menjaga keutuhan riwayat Order
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User      @relation(fields: [ownerId], references: [id])
  orders  Order[]
  reviews Review[]

  @@index([ownerId])
  @@index([status])
  @@index([isDeleted])
}

/**
 * Status siklus hidup pesanan sewa.
 *
 * - MENUNGGU_PEMBAYARAN : pesanan dibuat di Step 2, menunggu pembayaran di Step 3
 * - MENUNGGU_KONFIRMASI : pembayaran escrow diterima, menunggu pemilik setuju
 * - DIKIRIM             : pemilik telah menyetujui dan alat sedang dikirim
 * - SEWA_AKTIF          : alat sudah diterima penyewa (BAST awal OK)
 * - INSPEKSI            : penyewa sudah submit BAST akhir, menunggu inspeksi pemilik
 * - SELESAI             : sewa selesai, deposit dikembalikan
 * - DISPUTE             : ada klaim / sengketa
 * - DITOLAK             : pesanan ditolak
 */
enum OrderStatus {
  MENUNGGU_PEMBAYARAN
  MENUNGGU_KONFIRMASI
  DIKIRIM
  SEWA_AKTIF
  INSPEKSI
  SELESAI
  DISPUTE
  DITOLAK
}

model Order {
  id             String      @id @default(uuid())
  invoiceNumber  String      @unique
  userId         String
  equipmentId    String

  startDate      DateTime
  endDate        DateTime
  rentalDays     Int
  deliveryMethod String      // 'PICKUP' | 'COURIER'

  rentalCost     Int
  shippingCost   Int
  depositAmount  Int
  lateFee        Int         @default(0)
  damageFee      Int         @default(0)
  totalPaid      Int

  status         OrderStatus @default(MENUNGGU_PEMBAYARAN)

  // ── Checkout metadata ─────────────────────────────────────────────────────
  // Array layanan tambahan: [{id, label, price}]
  addons         Json?
  addonsCost     Int         @default(0)
  // Kode promo yang dipakai penyewa
  promoCode      String?
  discountAmount Int         @default(0)
  // Catatan bebas untuk pemilik alat
  renterNotes    String?     @db.Text
  // Waktu penyewa menyetujui kontrak sewa digital di Step 2
  contractAgreedAt DateTime?

  // ── Payment metadata ─────────────────────────────────────────────────────
  // 'QRIS' | 'VA_BCA' | 'EWALLET' | 'CARD'
  paymentMethod  String?
  paidAt         DateTime?
  // Batas waktu pembayaran (24 jam dari createdAt)
  paymentDeadline DateTime?

  // Data serah terima awal (BAST Awal: foto awal alat, checklist, catatan)
  initialBast    Json?

  // Data pengembalian Step 1-4 (jadwal, checklist, foto, tanda tangan, BAST Akhir).
  returnData     Json?
  disputeNote    String?     @db.Text
  disputeReason  String?     @db.Text
  // Foto bukti kerusakan dari pemilik saat mengajukan klaim / menolak BAST
  ownerInspectionPhotos Json?

  // Data putusan mediasi admin MyRent
  finalDamageFee      Int?
  adminResolutionNote String?     @db.Text
  resolvedAt          DateTime?
  isResolvedByAdmin   Boolean     @default(false)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id])
  equipment      Equipment   @relation(fields: [equipmentId], references: [id])
  review         Review?

  @@index([userId])
  @@index([equipmentId])
  @@index([status])
}

model Review {
  id          String   @id @default(uuid())
  orderId     String   @unique
  equipmentId String
  userId      String
  rating      Int
  comment     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([userId])
}

model Conversation {
  id            String    @id @default(uuid())
  renterId      String
  ownerId       String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  renter        User      @relation("RenterConversations", fields: [renterId], references: [id], onDelete: Cascade)
  owner         User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([renterId, ownerId])
  @@index([renterId])
  @@index([ownerId])
  @@index([lastMessageAt])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  content        String        @db.Text
  contextType    String?       // 'EQUIPMENT' | 'ORDER'
  contextData    Json?         // snapshot data alat / invoice pesanan
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model WithdrawalAccount {
  id            String   @id @default(uuid())
  userId        String
  bankName      String   // 'BCA', 'Mandiri', 'BRI', 'BNI', 'GoPay', 'OVO', 'DANA', dll
  accountNumber String
  accountHolder String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum WalletTransactionType {
  TOPUP
  WITHDRAW
  SEWA_PAYMENT
  DEPOSIT_HOLD
  DEPOSIT_REFUND
}

enum WalletTransactionStatus {
  BERHASIL
  MENUNGGU
  GAGAL
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  userId        String
  type          WalletTransactionType
  amount        Int
  description   String
  status        WalletTransactionStatus @default(BERHASIL)
  reference     String?
  paymentMethod String?
  createdAt     DateTime                @default(now())

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

