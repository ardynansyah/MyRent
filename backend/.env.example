# Port server API (default: 3000)
PORT=3000

# Origin yang diizinkan untuk CORS, dipisah koma (default: http://localhost:5173,http://127.0.0.1:5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production
NODE_ENV=development

# JWT Secret
JWT_SECRET="myrent_super_secret_jwt_key_2026"

# Koneksi database MySQL lokal (port 4000, password kosong)
DATABASE_URL="mysql://root:@127.0.0.1:4000/myrent_db"

